{
  "index": {
    "max_ngram_diff": 10
  },
  "analysis": {
    "analyzer": {
      "nori": {
        "type": "custom",
        "tokenizer": "nori_tokenizer",
        "filter": ["lowercase"]
      },
      "nori_ngram": {
        "type": "custom",
        "tokenizer": "nori_tokenizer",
        "filter": ["lowercase", "ngram_filter"]
      }
    },
    "filter": {
      "ngram_filter": {
        "type": "ngram",
        "min_gram": 1,
        "max_gram": 10
      }
    }
  }
}