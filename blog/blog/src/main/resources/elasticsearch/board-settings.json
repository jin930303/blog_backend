{
  "analysis": {
    "analyzer": {
      "nori": {
        "type": "custom",
        "tokenizer": "nori_tokenizer",
        "filter": [
          "lowercase"
        ]
      },
      "nori_edge_ngram": {
        "type": "custom",
        "tokenizer": "nori_tokenizer",
        "filter": ["lowercase", "edge_ngram_filter"]
      }
    },
    "filter": {
      "edge_ngram_filter": {
        "type": "edge_ngram",
        "min_gram": 1,
        "max_gram": 10
      }
    }
  }
}